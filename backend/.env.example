# Local PostgreSQL. Required; the app never creates the schema on startup.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/dear_my_diary

# HTTP server
HOST=127.0.0.1
PORT=8080

# Where attachment bytes are stored. Use a persistent volume in production.
STORAGE_ROOT=./storage

# Session and CSRF cookies
SESSION_TTL_HOURS=720
SESSION_COOKIE_NAME=dmd_session
CSRF_COOKIE_NAME=dmd_csrf

# Cookie behaviour. Keep Lax when the API serves the frontend itself.
# When the frontend is hosted on another site (Vercel, a CDN), set these to
# None and auto: the session cookie then crosses origins over HTTPS only.
# COOKIE_SAME_SITE=Lax
# COOKIE_SECURE=auto

# Browser origins allowed to call the API. Comma separated.
# ALLOWED_ORIGINS=https://your-app.vercel.app
# Allow any browser origin. Keep false unless you know why you need it.
CORS_ALLOW_ANY_ORIGIN=false

# Upload ceiling for attachments, in bytes
MAX_UPLOAD_BYTES=16777216

# Logging
RUST_LOG=dear_my_diary=debug,tower_http=info,sqlx=warn