# Local PostgreSQL. Required; the app never creates the schema on startup.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/dear_my_diary

# HTTP server
HOST=127.0.0.1
PORT=8080

# Where attachment bytes are stored
STORAGE_ROOT=./storage

# Session and CSRF cookies
SESSION_TTL_HOURS=720
SESSION_COOKIE_NAME=dmd_session
CSRF_COOKIE_NAME=dmd_csrf

# Allow any browser origin. Keep false unless you know why you need it.
CORS_ALLOW_ANY_ORIGIN=false

# Upload ceiling for attachments, in bytes
MAX_UPLOAD_BYTES=16777216

# Logging
RUST_LOG=dear_my_diary=debug,tower_http=info,sqlx=warn